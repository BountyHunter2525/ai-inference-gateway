# ═══════════════════════════════════════════════════════════════════════════════
# NexusAI Production Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ── Redis (REQUIRED for production) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Application ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ── Security ───────────────────────────────────────────────────────────────────
# CHANGE THESE IN PRODUCTION!
ADMIN_API_KEY=your-secure-admin-key-here
VALID_API_KEYS=your-production-key-1,your-production-key-2

# ── Cache ──────────────────────────────────────────────────────────────────────
CACHE_MAX_ENTRIES=1000
CACHE_DEFAULT_TTL_SECONDS=3600
SIMILARITY_THRESHOLD=0.92

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Enterprise Features ────────────────────────────────────────────────────────
QUOTA_DAILY_REQUESTS=5000
QUOTA_DAILY_TOKENS=500000
AUDIT_LOG_TTL_SECONDS=604800
AUDIT_LOG_MAX_ENTRIES=500

# ── LLM Providers (Optional) ───────────────────────────────────────────────────
HUGGINGFACE_API_TOKEN=
OPENAI_API_KEY=

# ── Monitoring ─────────────────────────────────────────────────────────────────
# Prometheus metrics enabled by default at /api/v1/metrics
