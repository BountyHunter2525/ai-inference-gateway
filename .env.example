# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security: Comma-separated authorized API keys
API_KEYS=sk-nexus-dev-demo-key,sk-test-client-123

# Redis & Storage
# Use redis://localhost:6379/0 for local standalone Redis
# If Redis is unavailable, NexusAI automatically switches to In-Memory fallback mode
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_FALLBACK=True

# Semantic Caching
SIMILARITY_THRESHOLD=0.92
DEFAULT_CACHE_TTL_SECONDS=3600

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# LLM Providers: "mock", "huggingface", "openai"
DEFAULT_LLM_PROVIDER=mock

# Hugging Face Settings (Optional if using HF)
HF_API_TOKEN=
HF_MODEL_NAME=google/flan-t5-base

# OpenAI / OpenRouter Settings (Optional if using OpenAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
