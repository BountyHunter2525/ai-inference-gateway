# ═══════════════════════════════════════════════════════════════════════════════
# NexusAI Gateway — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ── Redis Configuration ────────────────────────────────────────────────────────
# Redis is OPTIONAL - app will use in-memory cache if not available
# For Docker Compose: redis://redis:6379
# For local Redis: redis://localhost:6379
# For Render.com/Railway: They'll provide this URL
REDIS_URL=redis://localhost:6379

# ── LLM Provider Configuration ─────────────────────────────────────────────────
# Choose default provider: "groq", "openrouter", "huggingface", "openai", "mock"
DEFAULT_LLM_PROVIDER=groq

# ── LLM Provider API Keys ──────────────────────────────────────────────────────
# Get API keys from the following services:

# 1. Groq (FREE & FAST - Recommended for development)
#    Sign up: https://console.groq.com/keys
#    Models: llama-3.3-70b-versatile, mixtral-8x7b-32768, llama-3.1-70b-versatile
#    Free tier: Very generous limits, extremely fast inference
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# 2. OpenRouter (FREE TIER AVAILABLE)
#    Sign up: https://openrouter.ai/keys
#    Models: Many free models available (see https://openrouter.ai/models)
#    Free tier: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free

# 3. Hugging Face (FREE)
#    Sign up: https://huggingface.co/settings/tokens
#    Models: Many open-source models available
HUGGINGFACE_API_TOKEN=
HF_MODEL_NAME=google/flan-t5-base

# 4. OpenAI (PAID - Best quality but costs money)
#    Sign up: https://platform.openai.com/api-keys
#    Models: gpt-4o-mini, gpt-4o, gpt-4-turbo
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# ── Cache Configuration ────────────────────────────────────────────────────────
# Maximum number of entries before LRU eviction kicks in
CACHE_MAX_ENTRIES=500

# Default TTL in seconds (overridden by adaptive TTL)
CACHE_DEFAULT_TTL_SECONDS=3600

# Minimum similarity score for cache hit (0.0 to 1.0)
# 0.92 = 92% similar (recommended)
SIMILARITY_THRESHOLD=0.92

# ── Rate Limiter ───────────────────────────────────────────────────────────────
# Max requests per API key in the time window
RATE_LIMIT_MAX_REQUESTS=100

# Time window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# ── Enterprise Features (Option 4) ─────────────────────────────────────────────
# Admin API key for managing other keys
ADMIN_API_KEY=sk-nexus-admin-master-key

# Daily quotas (null = unlimited)
QUOTA_DAILY_REQUESTS=1000
QUOTA_DAILY_TOKENS=100000

# Audit log settings
AUDIT_LOG_TTL_SECONDS=604800     # 7 days
AUDIT_LOG_MAX_ENTRIES=200

# ── Application ────────────────────────────────────────────────────────────────
# Host and port (0.0.0.0 allows external connections)
HOST=0.0.0.0
PORT=8000

# Debug mode (set to False in production)
DEBUG=False

# ── Authentication ─────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys
# Default key is pre-configured: sk-nexus-dev-demo-key
VALID_API_KEYS=sk-nexus-dev-demo-key,your-custom-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# Quick Start Guide:
# 
# 1. For Local Testing with Real AI (Recommended):
#    - Get free Groq API key: https://console.groq.com/keys
#    - Add GROQ_API_KEY=your-key-here above
#    - Run: cd backend && uvicorn app.main:app --reload
#    - Access: http://localhost:8000
#    - API Key: sk-nexus-dev-demo-key
#
# 2. For Mock Testing (No API keys needed):
#    - Set DEFAULT_LLM_PROVIDER=mock
#    - Run: cd backend && uvicorn app.main:app --reload
#    - Access: http://localhost:8000
#
# 3. For Production Deployment:
#    - Get production API keys from your preferred provider
#    - Set REDIS_URL from your hosting platform
#    - Change VALID_API_KEYS to secure values
#    - Set DEBUG=False
#    - Deploy to Render, Railway, or your platform
#
# Provider Recommendations:
# - Development: Groq (free, fast, high quality)
# - Production: OpenRouter or OpenAI (better reliability)
# - Budget: OpenRouter free tier (good quality, no cost)
# ═══════════════════════════════════════════════════════════════════════════════
